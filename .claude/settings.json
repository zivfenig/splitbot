{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(head *.env)",
      "Bash(head * *.env)",
      "Bash(tail *.env)",
      "Bash(tail * *.env)",
      "Bash(grep * *.env)",
      "Bash(rg * *.env)",
      "Bash(sed * *.env)",
      "Bash(awk * *.env)",
      "Bash(cp *.env *)",
      "Bash(source *.env)",
      "Bash(. *.env)",
      "Bash(env)",
      "Bash(printenv*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pytest_on_stop.py\"",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
