# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
# Price per 1M tokens in USD, from OpenAI's pricing page. Leave empty = cost shown as unknown.
OPENAI_PRICE_IN_PER_MTOK=
OPENAI_PRICE_OUT_PER_MTOK=

TELEGRAM_BOT_TOKEN=
# Test group chat id (negative number). Find it with: python scripts/smoke_telegram.py --find-chat
TELEGRAM_CHAT_ID=

SPLITWISE_API_KEY=
SPLITWISE_GROUP_NAME=SplitBot Test
