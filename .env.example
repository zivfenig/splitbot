# Copy to .env and fill in. Never commit .env.

# OpenAI: extraction, agent, embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Model prices are not secrets: they live in config/prices.json.

# Jev (TypeSafe decision model) via OpenRouter: the router
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# The router's ignore/pass threshold, fixed from the Stage C test-set experiment (do not re-tune
# by hand; a new value needs its own experiment, same as the router/model choices themselves).
ROUTER_IGNORE_THRESHOLD=0.485

# The agent's own model (tool calling). Deliberately a SEPARATE setting from OPENAI_MODEL: the
# extractor keeps using OPENAI_MODEL (gpt-4o-mini, frozen from the Stage B experiment) for every
# write tool's extraction call; only the agent's own tool-calling loop reads this one.
AGENT_MODEL=gpt-5.4-mini
# The most one agent turn's own model calls may cost, in dollars
AGENT_MAX_COST_USD=0.02

# Pending write actions (new expense, correction, delete) expire after this many hours
PENDING_EXPIRY_HOURS=1
# `auto` mode (opt-in): seconds the sender has to correct or reject before it commits
AUTO_GRACE_SECONDS=60

# Telegram
TELEGRAM_BOT_TOKEN=
# Test group chat id (negative number). Find it with: python scripts/smoke_telegram.py --find-chat
TELEGRAM_CHAT_ID=

# Where the ledger's SQLite file lives (the bot's own long-lived Store; ":memory:" for a
# throwaway run, never used for the real bot)
DB_PATH=splitbot.db
# Dedicated correction diagnostics (rotating local file; no HTTP headers or bot token)
DEBUG_LOG_PATH=splitbot-debug.log

# Optional architecture switch. Keep "legacy" until v4 Telegram acceptance testing begins.
# Both modes use the same ledger; v4 stores only its pending conversational state in isolated
# v4_workflows/v4_workflow_events tables.
