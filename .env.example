# Copy to .env and fill in. Never commit .env.

# OpenAI: extraction, agent, embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Model prices are not secrets: they live in config/prices.json.

# Jev (TypeSafe decision model) via OpenRouter: the router
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Telegram
TELEGRAM_BOT_TOKEN=
# Test group chat id (negative number). Find it with: python scripts/smoke_telegram.py --find-chat
TELEGRAM_CHAT_ID=
